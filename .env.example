# This is an example .env file. Copy this file to .env and fill in the values.
# .env is gitignored and should not be committed to version control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

# Set the currently used Inference platform (e.g. openai, omniroute, gemini etc) API key, base URL and model from variables defined above. This allows you to switch between different inference platforms easily.
INFERENCE_API_KEY=${GEMINI_API_KEY}
INFERENCE_BASE_URL=${GEMINI_BASE_URL}
INFERENCE_MODEL=${GEMINI_MODEL}

# Web search
TAVILY_API_KEY=your_tavily_api_key_here